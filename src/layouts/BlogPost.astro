---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, CATEGORIES } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { id?: string };

const { title, description, pubDate, updatedDate, category, tags, id } = Astro.props;
const cat = CATEGORIES.find((c) => c.key === category);
const catLabel = cat?.label ?? 'Blog';
const catHref = cat ? `/category/${cat.slug}` : '/blog';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<div class="container">
			<nav class="breadcrumb">
				<span>You are here:</span>
				<a href="/">Home</a> &raquo;
				<a href={catHref}>{catLabel}</a> &raquo;
				<span>{title}</span>
			</nav>
			<div class="layout">
				<article class="article">
					<h1>{title}</h1>
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated-on">
									&middot; updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</p>
					<slot />
				</article>
				<Sidebar tags={tags} currentId={id} />
			</div>
		</div>
		<Footer />
	</body>
</html>
