---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return CATEGORIES.map((cat) => ({
		params: { slug: cat.slug },
		props: {
			cat,
			posts: posts
				.filter((p) => (p.data.category ?? 'notes') === cat.key)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { cat, posts } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${cat.label} — ${SITE_TITLE}`} description={cat.blurb} />
	</head>
	<body>
		<Header />
		<div class="container">
			<nav class="breadcrumb">
				<span>You are here:</span>
				<a href="/">Home</a> &raquo;
				<span>{cat.label}</span>
			</nav>
			<div class="layout">
				<article class="article">
					<h1>{cat.label}</h1>
					<p class="lede">{cat.blurb}</p>
					{
						posts.length === 0 ? (
							<p class="muted">还没有这个分类的文章，敬请期待。</p>
						) : (
							<ul class="post-list">
								{posts.map((post) => (
									<li>
										<a class="post-title" href={`/blog/${post.id}/`}>
											{post.data.title}
										</a>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<p class="post-desc">{post.data.description}</p>
									</li>
								))}
							</ul>
						)
					}
				</article>
				<Sidebar currentId={undefined} />
			</div>
		</div>
		<Footer />
	</body>
</html>
