---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Lessons — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="container">
			<nav class="breadcrumb">
				<span>You are here:</span>
				<a href="/">Home</a> &raquo;
				<span>Lessons</span>
			</nav>
			<div class="layout">
				<article class="article">
					<h1>Lessons</h1>
					<p class="lede">
						Write-ups, troubleshooting notes and automation experiments from the CLI.
						New posts land here as I break and fix things in the lab.
					</p>
					<ul class="post-list">
						{
							posts.map((post) => (
								<li>
									<a class="post-title" href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
									<p class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p class="post-desc">{post.data.description}</p>
								</li>
							))
						}
					</ul>
				</article>
				<aside class="sidebar">
					<div class="sidebar-box">
						<h3>Course Contents</h3>
						<div class="toc-group">
							<p class="toc-title">Routing Fundamentals</p>
							<ul>
								<li><a href="/blog/welcome/">Welcome to netops.sh</a></li>
								<li><a href="/blog/bgp-troubleshooting/">BGP Troubleshooting</a></li>
								<li><a href="/blog/config-backup-netmiko/">Config Backup with Netmiko</a></li>
							</ul>
						</div>
						<div class="toc-group">
							<p class="toc-title">More</p>
							<ul>
								<li><a href="/about">About Me</a></li>
							</ul>
						</div>
					</div>
				</aside>
			</div>
		</div>
		<Footer />
	</body>
</html>
