---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const projects = [
	{
		name: 'Home Lab / EVE-NG Topology',
		desc: 'Multi-vendor lab (Cisco, Juniper, Arista) for BGP, OSPF, MPLS L3VPN and segment routing practice.',
		tags: ['BGP', 'MPLS', 'EVE-NG', 'Segment Routing'],
	},
	{
		name: 'Network Automation Toolkit',
		desc: 'Ansible + Python (Netmiko / NAPALM) playbooks for zero-touch provisioning and config backup.',
		tags: ['Ansible', 'Python', 'Netmiko', 'NAPALM'],
	},
	{
		name: 'Observability Stack',
		desc: 'Telemetry pipeline with SNMP, gNMI, Telegraf, InfluxDB and Grafana dashboards for the WAN edge.',
		tags: ['gNMI', 'Telegraf', 'Grafana', 'SNMP'],
	},
	{
		name: 'Secure SD-WAN Design',
		desc: 'Reference design for a hub-and-spoke SD-WAN overlay with IPsec, zone-based firewall and QoS.',
		tags: ['SD-WAN', 'IPsec', 'QoS', 'Firewall'],
	},
];

const skills = [
	{ area: 'Routing & Switching', detail: 'BGP · OSPF · IS-IS · EVPN/VXLAN · STP' },
	{ area: 'Automation', detail: 'Python · Ansible · Netmiko · NAPALM · Nornir' },
	{ area: 'Security', detail: 'IPsec · Zone-Based FW · 802.1X · ACL/NAC' },
	{ area: 'Cloud & DC', detail: 'AWS VPC · Terraform · Spine-Leaf · MLAG' },
	{ area: 'Monitoring', detail: 'gNMI · SNMP · Grafana · Wireshark · Netflow' },
];

const contents = [
	{ group: 'Routing Fundamentals', items: [
		{ title: 'Welcome to netops.sh', href: '/blog/welcome/' },
		{ title: 'BGP Troubleshooting Cheat Sheet', href: '/blog/bgp-troubleshooting/' },
		{ title: 'Automating Config Backups', href: '/blog/config-backup-netmiko/' },
	]},
	{ group: 'More', items: [
		{ title: 'All Lessons', href: '/blog' },
		{ title: 'About Me', href: '/about' },
	]},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="breadcrumb">
				<div class="container">
					You are here: <a href="/">Home</a> &raquo; Network Engineering
				</div>
			</div>

			<div class="container">
				<div class="layout">
					<article class="article">
						<h1>Network Engineering, explained simply</h1>
						<p class="lede">{SITE_DESCRIPTION}</p>

						<p>
							Welcome. This is my working notebook as a network engineer — the
							place where I write down how routing and switching actually
							behave, how I automate the boring parts, and how I troubleshoot
							when things break at 2 a.m.
						</p>
						<p>
							Everything here is meant to be practical: real CLI output, real
							configs, and topologies you can rebuild in your own lab. Start
							with the lessons in the sidebar, or browse the
							<a href="/blog">full list</a>.
						</p>

						<h2>Skills</h2>
						<ul class="skill-list">
							{skills.map((s) => (
								<li>
									<span>{s.area}</span>
									<span>{s.detail}</span>
								</li>
							))}
						</ul>

						<h2>Featured Projects</h2>
						<div class="card-grid">
							{projects.map((p) => (
								<div class="card">
									<h3>{p.name}</h3>
									<p>{p.desc}</p>
									<ul class="tags">
										{p.tags.map((t) => <li>{t}</li>)}
									</ul>
								</div>
							))}
						</div>

						<a class="next-lesson" href="/blog">
							<strong>Start Reading</strong>
							Browse all lessons &amp; troubleshooting notes &raquo;
						</a>
					</article>

					<aside class="sidebar">
						<div class="sidebar-box">
							<h2>Course Contents</h2>
							{contents.map((c) => (
								<div>
									<div class="toc-group">{c.group}</div>
									<ul>
										{c.items.map((i) => (
											<li><a href={i.href}>{i.title}</a></li>
										))}
									</ul>
								</div>
							))}
						</div>
					</aside>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
