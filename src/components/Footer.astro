---
import { SITE_TITLE, SOCIAL } from '../consts';
const today = new Date();
---

<footer>
	<div class="container footer-inner">
		<div class="copyright">&copy; {2025} - {today.getFullYear()} {SITE_TITLE}</div>
		<ul>
			<li><a href="/about">About</a></li>
			<li><a href="/blog">Lessons</a></li>
			<li><a href={SOCIAL.github} target="_blank">GitHub</a></li>
			<li><a href={SOCIAL.linkedin} target="_blank">LinkedIn</a></li>
			<li><a href={SOCIAL.email}>Contact</a></li>
		</ul>
	</div>
</footer>
<style>
	footer {
		background: rgb(var(--heading));
		color: rgba(255, 255, 255, 0.75);
		font-size: 0.85rem;
		margin-top: auto;
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.4rem;
		padding-bottom: 1.4rem;
		flex-wrap: wrap;
	}
	footer ul {
		display: flex;
		gap: 1.2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	footer li {
		margin: 0;
	}
	footer a {
		color: rgba(255, 255, 255, 0.85);
	}
	footer a:hover {
		color: #fff;
	}
</style>
