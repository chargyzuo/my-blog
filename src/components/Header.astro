---
import { CATEGORIES, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="container header-inner">
		<nav>
			<ul>
				<li><HeaderLink href="/">Home</HeaderLink></li>
				<li><a href="/" class="brand">{SITE_TITLE}</a></li>
				{
					CATEGORIES.map((c) => (
						<li>
							<HeaderLink href={`/category/${c.slug}/`}>{c.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</nav>
		<form class="search" action="/blog">
			<input type="search" name="q" placeholder="Search…" aria-label="Search" />
			<button type="submit" aria-label="Search">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
					><path fill="currentColor" d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"></path></svg
				>
			</button>
		</form>
	</div>
</header>

<style>
	header {
		background: rgb(var(--bg));
		border-bottom: 1px solid rgb(var(--border));
		box-shadow: var(--box-shadow);
		position: sticky;
		top: 0;
		z-index: 20;
	}
	.header-inner {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		padding-top: 0.85rem;
		padding-bottom: 0.85rem;
	}
	.brand {
		font-size: 1.3rem;
		font-weight: 800;
		color: rgb(var(--heading));
		white-space: nowrap;
	}
	.brand:hover {
		text-decoration: none;
		color: var(--accent);
	}
	nav {
		flex: 1;
	}
	nav ul {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.3rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav li {
		margin: 0;
	}
	nav a {
		display: block;
		padding: 0.5rem 0.8rem;
		color: rgb(var(--ink));
		font-size: 0.95rem;
		font-weight: 600;
		border-radius: 4px;
	}
	nav a:hover,
	nav a.active {
		color: var(--accent);
		text-decoration: none;
		background: rgb(var(--bg-soft));
	}
	.search {
		display: flex;
		align-items: center;
		border: 1px solid rgb(var(--border));
		border-radius: 4px;
		overflow: hidden;
	}
	.search input {
		border: none;
		outline: none;
		padding: 0.4rem 0.6rem;
		font-size: 0.9rem;
		width: 140px;
	}
	.search button {
		border: none;
		background: rgb(var(--bg-soft));
		color: rgb(var(--gray));
		padding: 0.45rem 0.6rem;
		cursor: pointer;
		display: flex;
	}
	.search button:hover {
		color: var(--accent);
	}
	@media (max-width: 900px) {
		.header-inner {
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		.search {
			order: 3;
			flex: 1;
		}
		.search input {
			width: 100%;
		}
	}
	@media (max-width: 720px) {
		nav ul {
			flex-wrap: wrap;
		}
	}
</style>
