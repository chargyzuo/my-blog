---
import { CATEGORIES, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="side-inner">
		<a href="/" class="brand">{SITE_TITLE}</a>

		<form class="search" action="/blog">
			<input type="search" name="q" placeholder="Search…" aria-label="Search" />
			<button type="submit" aria-label="Search">
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
					><path fill="currentColor" d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"></path></svg
				>
			</button>
		</form>

		<nav>
			<ul>
				<li><HeaderLink href="/">Home</HeaderLink></li>
				{
					CATEGORIES.map((c) => (
						<li>
							<HeaderLink href={`/category/${c.slug}/`}>{c.label}</HeaderLink>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		width: 240px;
		background: rgb(var(--bg-soft));
		border-right: 1px solid rgb(var(--border));
		overflow-y: auto;
		z-index: 20;
	}
	.side-inner {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.6rem 1.25rem;
	}
	.brand {
		font-size: 1.4rem;
		font-weight: 800;
		color: rgb(var(--heading));
		white-space: nowrap;
	}
	.brand:hover {
		text-decoration: none;
		color: var(--accent);
	}
	nav ul {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.15rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav li {
		margin: 0;
	}
	nav a {
		display: block;
		padding: 0.55rem 0.7rem;
		color: rgb(var(--ink));
		font-size: 0.98rem;
		font-weight: 600;
		border-radius: 6px;
	}
	nav a:hover,
	nav a.active {
		color: var(--accent);
		text-decoration: none;
		background: rgb(var(--bg));
	}
	.search {
		display: flex;
		align-items: center;
		border: 1px solid rgb(var(--border));
		border-radius: 6px;
		overflow: hidden;
		background: rgb(var(--bg));
	}
	.search input {
		border: none;
		outline: none;
		padding: 0.45rem 0.6rem;
		font-size: 0.9rem;
		width: 100%;
		background: transparent;
	}
	.search button {
		border: none;
		background: transparent;
		color: rgb(var(--gray));
		padding: 0.45rem 0.6rem;
		cursor: pointer;
		display: flex;
	}
	.search button:hover {
		color: var(--accent);
	}
	/* On narrow screens the sidebar collapses into a normal top bar */
	@media (max-width: 900px) {
		header {
			position: static;
			width: auto;
			bottom: auto;
			border-right: none;
			border-bottom: 1px solid rgb(var(--border));
		}
		.side-inner {
			flex-direction: row;
			align-items: center;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		.brand {
			flex: 0 0 auto;
		}
		.search {
			order: 3;
			flex: 1 1 100%;
		}
		nav {
			flex: 1 1 100%;
		}
		nav ul {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.3rem;
		}
	}
</style>
